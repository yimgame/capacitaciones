# Copiá este archivo a .env y completá. NO subas el .env al repo.
# Contraseña del primer usuario administrador (usuario "admin"); solo se usa la primera vez,
# cuando la base está vacía. Al entrar te pide cambiarla.
PANEL_ADMIN_PASSWORD=cambiame-por-una-larga
# Opcional: otro nombre para el primer admin
# PANEL_ADMIN_USER=admin
# Puerto donde queda publicada la página
PUERTO=8097
